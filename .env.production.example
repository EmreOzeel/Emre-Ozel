# ══════════════════════════════════════════════════════════════════════════════
# PCAP Analyzer — Production Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env before deploying:
#   cp .env.production.example .env
#
# Then fill in ALL "REQUIRED" values below.
# Generate random secrets with:
#   openssl rand -hex 32    (for POSTGRES_PASSWORD)
#   openssl rand -hex 64    (for JWT_SECRET)
#   openssl rand -base64 24 (for DEFAULT_PASS)

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — you MUST change these before first deploy
# ═══════════════════════════════════════════════════════════════════════════════

# Your public domain name. SSL certs must match this.
# Used for nginx server_name, CORS origin, and HSTS.
DOMAIN=pcap.yourcompany.com

# PostgreSQL password. Min 32 characters, randomly generated.
# Example: openssl rand -hex 32
POSTGRES_PASSWORD=

# JWT signing secret. Min 64 characters, randomly generated.
# Changing this invalidates all active sessions.
# Example: openssl rand -hex 64
JWT_SECRET=

# Initial admin account credentials (created on first startup only).
DEFAULT_USER=admin

# Admin password. Min 16 characters.
# Example: openssl rand -base64 24
DEFAULT_PASS=

# ═══════════════════════════════════════════════════════════════════════════════
# Collector — live syslog / NetFlow ingestion
# ═══════════════════════════════════════════════════════════════════════════════

# Enable the live syslog collector (UDP+TCP on port 5514).
# Point your firewalls/load balancers to this host on port 5514.
COLLECTOR_ENABLED=true

# Device role tag applied to all ingested events.
# Values: perimeter | internal | dmz | unknown
COLLECTOR_DEVICE_ROLE=perimeter

# How many days to keep live events before automatic purge.
# Higher = more disk usage but longer investigation window.
RETENTION_DAYS=30

# Enable NetFlow/IPFIX listener on UDP port 2055.
NETFLOW_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# GeoIP — geographic enrichment
# ═══════════════════════════════════════════════════════════════════════════════

# Enable GeoIP lookups for IP geolocation and ASN data.
GEOIP_ENABLED=true

# MaxMind GeoLite2 database files (optional but recommended).
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# Place .mmdb files in ./geoip/ directory (mounted read-only).
# If not provided, falls back to ip-api.com (rate-limited, less accurate).
GEOIP_CITY_DB=/data/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB=/data/geoip/GeoLite2-ASN.mmdb

# ═══════════════════════════════════════════════════════════════════════════════
# PCAP Trigger — automatic targeted packet capture
# ═══════════════════════════════════════════════════════════════════════════════

# Enable automatic PCAP capture when anomalous traffic is detected.
# Requires tcpdump installed and a capture-capable interface.
PCAP_TRIGGER_ENABLED=false

# Network interface to capture on (e.g. eth0, span0, ens192).
# Must be set if PCAP_TRIGGER_ENABLED=true.
PCAP_TRIGGER_INTERFACE=

# Duration of each triggered capture in seconds.
PCAP_TRIGGER_DURATION=30

# Maximum number of concurrent captures.
PCAP_TRIGGER_MAX_CONCURRENT=5

# ═══════════════════════════════════════════════════════════════════════════════
# Packet Engine — Go-based SPAN packet capture
# ═══════════════════════════════════════════════════════════════════════════════

# SPAN capture interface (e.g. eth1, span0, ens224)
PACKET_INTERFACE=eth1

# JWT token for packet engine → backend API auth
# Example: openssl rand -hex 32
PACKET_ENGINE_TOKEN=

# Optional BPF filter for captured traffic (e.g. "not port 22")
PACKET_BPF_FILTER=

# ═══════════════════════════════════════════════════════════════════════════════
# Optional — safe defaults provided
# ═══════════════════════════════════════════════════════════════════════════════

# JWT token lifetime in hours.
JWT_EXPIRE_HOURS=24

# Maximum PCAP upload size in megabytes.
MAX_UPLOAD_MB=500

# Maximum analysis processing time before timeout.
ANALYSIS_TIMEOUT_SEC=300

# Per-user analysis quota (0 = unlimited).
MAX_ANALYSES_PER_USER=0
