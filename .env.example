# Copy this file to .env and customize before production deployment.

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: change this before deploying
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE_HOURS=24

# Default admin account created on first startup
DEFAULT_USER=admin
DEFAULT_PASS=admin123

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite at DB_PATH (default, good for single-node)
# Set to a PostgreSQL URL for multi-instance or production deployments:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/pcap
DATABASE_URL=
DB_PATH=/data/pcap.db

# ── Upload security ───────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
ANALYSIS_TIMEOUT_SEC=300
# 0 = unlimited per-user analysis quota
MAX_ANALYSES_PER_USER=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict in production to your frontend domain:
#   ALLOWED_ORIGINS=["https://pcap.yourcompany.com"]
ALLOWED_ORIGINS=["*"]
