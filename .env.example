# Copy this file to .env and customize before production deployment.

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: change this before deploying
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE_HOURS=24

# Default admin account created on first startup
DEFAULT_USER=admin
DEFAULT_PASS=admin123

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite at DB_PATH (default, good for single-node)
# Set to a PostgreSQL URL for multi-instance or production deployments:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/pcap
DATABASE_URL=
DB_PATH=/data/pcap.db

# ── Upload security ───────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
ANALYSIS_TIMEOUT_SEC=300
# 0 = unlimited per-user analysis quota
MAX_ANALYSES_PER_USER=0

# ── Live collector (syslog ingestion) ─────────────────────────────────────────
# Set to true to start the syslog listener on startup.
# Devices (firewalls, load balancers) should forward syslog to SYSLOG_PORT.
COLLECTOR_ENABLED=true

# Bind address and port for the syslog listener (UDP + TCP).
# Use a non-privileged port (>1024) and forward from 514 via iptables/rsyslog.
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5514

# Buffer tuning: events are batched in memory and flushed to the database
# either every FLUSH_INTERVAL seconds or when the buffer reaches BATCH_SIZE,
# whichever comes first.
COLLECTOR_FLUSH_INTERVAL=1.0
COLLECTOR_BATCH_SIZE=100

# Identifier for the collector instance. Leave empty to auto-detect hostname.
COLLECTOR_SOURCE_ID=

# Default device role assigned to ingested events (perimeter / internal / dmz).
COLLECTOR_DEVICE_ROLE=perimeter

# Live events older than RETENTION_DAYS are automatically purged.
RETENTION_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict in production to your frontend domain:
#   ALLOWED_ORIGINS=["https://pcap.yourcompany.com"]
ALLOWED_ORIGINS=["*"]
